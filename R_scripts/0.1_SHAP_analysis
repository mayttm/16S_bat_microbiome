## ----- SHAP ANALYSIS

library(randomForest)
library(fastshap)
library(readr)
library(dplyr)

# 1. Load Data
df <- read_csv("output_bioproj_prim/_SHAP/rf_data_sub.csv")

# 2. Prepare X and y
# Python Logic: X = df.drop(columns=["Diet_type"])
target_col <- "Diet_type"
X <- df[, !names(df) %in% target_col]
y <- as.factor(df[[target_col]])

# 3. TRAIN RANDOM FOREST MODEL
# -----------------------------------------------------------------------------
set.seed(1000)
# ntree=500 matches Python's n_estimators=500
rf_model <- randomForest(x = X, y = y, ntree = 500, importance = TRUE)

print("Model training complete.")

# 4. EXPORT FEATURE MATRIX (X)
# -----------------------------------------------------------------------------
# Save to 'output' folder
write_csv(X, "output_bioproj_prim/_SHAP/features_160.csv")
message("Exported: output_bioproj_prim/_SHAP/features_160.csv")

# 5. CALCULATE SHAP VALUES
# -----------------------------------------------------------------------------
classes <- levels(y)

for (class_name in classes) {
  message(paste("Calculating SHAP values for class:", class_name, "..."))
  
  # Wrapper function to get probability for the specific class
  pfun <- function(object, newdata) {
    probs <- predict(object, newdata = newdata, type = "prob")
    return(probs[, class_name])
  }
  
  # Calculate SHAP values
  # nsim controls the approximation accuracy. 
  # Increase nsim (e.g., 50 or 100) for values closer to Python's TreeExplainer.
  shap_values <- fastshap::explain(
    rf_model,
    X = X,
    pred_wrapper = pfun,
    nsim = 10 
  )
  
  # Save to 'output' folder
  filename <- paste0("output_bioproj_prim/_SHAP/shap_values_160_class_", class_name, ".csv")
  
  # Export
  write_csv(as.data.frame(shap_values), filename)
  message(paste("Exported:", filename))
}

