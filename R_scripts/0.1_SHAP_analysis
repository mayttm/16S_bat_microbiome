library(ggplot2)
library(dplyr)
library(tidyr)
library(shapviz)   
library(patchwork) 

# 1. DEFINE COLORS
# ---------------------------------------------------------
diet_colors <- c(
  "Insect" = "#ff5e2b",
  "Blood"  = "#ba0970",
  "Fruit"  = "#2E8B57",
  "Fish"   = "#303F9F"
)

# 2. GENERATE INDIVIDUAL PLOTS (Beeswarm)
# ---------------------------------------------------------
# We capture the plots into variables p1, p2, p3
p1 <- sv_importance(sv_fish, kind = "beeswarm") + ggtitle("Fish Class Importance")
p2 <- sv_importance(sv_fruit, kind = "beeswarm") + ggtitle("Fruit Class Importance")
p3 <- sv_importance(sv_insect, kind = "beeswarm") + ggtitle("Insect Class Importance")

# 3. GENERATE SUMMARY BAR PLOT (Aggregated)
# ---------------------------------------------------------

# Create dataframes from shap values (shap0, shap1, shap2 must exist in environment)
df_fish   <- as.data.frame(shap0)   %>% summarise_all(~mean(abs(.))) %>% mutate(Class="Fish")
df_fruit  <- as.data.frame(shap1)   %>% summarise_all(~mean(abs(.))) %>% mutate(Class="Fruit")
df_insect <- as.data.frame(shap2)   %>% summarise_all(~mean(abs(.))) %>% mutate(Class="Insect")

# Combine and pivot
shap_bar <- bind_rows(df_fish, df_fruit, df_insect) %>%
  pivot_longer(cols = -Class, names_to = "Feature", values_to = "Mean_SHAP")

# Calculate totals to filter top 20
top_features_list <- shap_bar %>%
  group_by(Feature) %>%
  summarise(Total = sum(Mean_SHAP)) %>%
  arrange(desc(Total)) %>%
  slice(1:20) %>%
  pull(Feature)

# Filter data for plotting
shap_bar_top <- shap_bar %>% 
  filter(Feature %in% top_features_list)

# Create the Feature Plot (p4) using YOUR colors
p4 <- ggplot(shap_bar_top, aes(x = reorder(Feature, Mean_SHAP), y = Mean_SHAP, fill = Class)) +
  geom_col(position = position_dodge(width = 0.8), width = 0.7) +
  coord_flip() +
  theme_minimal(base_size = 12) +
  labs(
    title = "Top 20 Features Summary",
    x = "Feature",
    y = "Mean |SHAP|"
  ) +
  scale_fill_manual(values = diet_colors) # <--- UPDATED HERE

# 4. COMBINE PLOTS INTO 2x2 PANEL
# ---------------------------------------------------------
# Using patchwork: (p1 | p2) / (p3 | p4) creates a 2x2 grid
combined_plot <- (p1 | p2) / (p3 | p4) +
  plot_annotation(tag_levels = 'A') 

print(combined_plot)

# 5. EXPORT
# ---------------------------------------------------------
# Define output path (modify as needed)
output_dir <- "output_bioproj_prim"
if (!dir.exists(output_dir)) dir.create(output_dir, recursive = TRUE)

base_filename <- file.path(output_dir, "SHAP_panel")
w <- 16
h <- 12

ggsave(paste0(base_filename, ".jpg"), combined_plot, width = w, height = h, dpi = 300, bg = "white")

ggsave(paste0(base_filename, ".pdf"), combined_plot, width = w, height = h, dpi = 300, bg = "white")

ggsave(paste0(base_filename, ".tiff"), combined_plot, width = w, height = h, dpi = 300, bg = "white", compression = "lzw")

message("Plots exported successfully to ", output_dir)
