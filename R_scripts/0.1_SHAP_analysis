# Since the prediction accuracy for Bioproject is high,
# let's use a different strategy, namely LOBO (leave-one-bioproject-out), 
# so the training set will consist of all Bioprojects except one, which will be used
# as the test set. Why? Because I want to achieve high prediction accuracy 
# even when I introduce new Bioprojects

bioprojects <- unique(df$bioproject)
results_list <- list()

for (bp in bioprojects) {
  
  train_idx <- which(df$bioproject != bp)
  test_idx  <- which(df$bioproject == bp)
  
  train_classes <- unique(rf_data$Diet_type[train_idx])
  test_classes  <- unique(rf_data$Diet_type[test_idx])
  
  if (!all(test_classes %in% train_classes)) {
    message("Skipping ", bp, ": diet classes dieta not represented in the train")
    next
  }
  
  train_data <- rf_data[train_idx, ]
  test_data  <- rf_data[test_idx, ]
  
  set.seed(1000)
  rf_tmp <- randomForest(
    x          = train_data[, -1],
    y          = train_data$Diet_type,
    ntree      = 500,
    importance = TRUE
  )
  
  preds <- predict(rf_tmp, newdata = test_data[, -1])
  acc   <- mean(preds == test_data$Diet_type)
  
  # Confusion matrix per bioproject
  cm <- table(Predicted = preds, Observed = test_data$Diet_type)
  
  results_list[[bp]] <- data.frame(
    Bioproject        = bp,
    N_test            = length(test_idx),
    Accuracy          = round(acc, 3),
    Diet_composition  = paste(
      names(table(test_data$Diet_type)),
      table(test_data$Diet_type),
      sep = "=", collapse = " | "
    )
  )
  
  message(sprintf("%-20s | N=%d | Acc=%.3f | %s",
                  bp, length(test_idx), acc,
                  results_list[[bp]]$Diet_composition))
}

