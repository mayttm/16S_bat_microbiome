# ============================================================================ #
# ----------- 3.2) Variable Importance CLR Abundance (GENUS level) ----------- #
## ------------------------ Predictor: Diet_type ---------------------------- ##
# ============================================================================ #

library(randomForest)
library(tidyverse)
library(caret)
library(vegan) 

# 1. Filter for multi-diet bioprojects
multi_diet_bp <- c("PRJEB47836", "PRJNA602518",
                   "PRJNA1012124", "PRJNA1096155",
                   "PRJNA508738")

df_multi <- df %>% filter(bioproject %in% multi_diet_bp)

# 2. Extract Abundance Data
abundance_sub <- df_multi[, grep("d__Bacteria", colnames(df_multi)), drop = FALSE]

set.seed(1000)
abundance_sub <- rrarefy(abundance_sub, sample = 5000)

# 3. Define Helper Functions (extract_genus & clr_transform)
extract_genus <- function(t) {
  if (!grepl("g__", t)) return(NA_character_)
  g <- sub(".*g__([^;]+).*", "\\1", t)
  if (g == "" || is.na(g)) return(NA_character_) else return(g)
}

clr_transform <- function(x) {
  # Add pseudocount of 1 to handle zeros
  x <- x + 1
  log(x / exp(mean(log(x))))
}

# 4. Aggregate to Genus Level
# Note: abundance_sub is now a matrix from rrarefy, so we ensure column names are preserved
genus_names_sub <- sapply(colnames(abundance_sub), extract_genus)
keep_sub <- !is.na(genus_names_sub)

abundance_genus_sub <- rowsum(
  t(abundance_sub[, keep_sub, drop = FALSE]),
  group = genus_names_sub[keep_sub],
  na.rm = TRUE
)
abundance_genus_sub <- t(abundance_genus_sub)

# 5. Remove Organelles
abundance_genus_sub <- abundance_genus_sub[,
                                           !(colnames(abundance_genus_sub) %in%
                                               c("Chloroplast", "Mitochondria")), drop = FALSE]

# 6. Apply CLR Transformation
# Note: CLR is applied AFTER rarefaction and aggregation
clr_sub <- t(apply(abundance_genus_sub, 1, clr_transform))

# 7. Prepare Final Training Data
rf_data_sub <- cbind(
  Diet_type = factor(df_multi$diet_1),
  as.data.frame(clr_sub)
)

# Ensure unique column names and correct factor levels
colnames(rf_data_sub) <- make.unique(colnames(rf_data_sub))
rf_data_sub$Diet_type <- as.factor(rf_data_sub$Diet_type)

# 8. Train the Final Model with 5-Fold CV using Caret
set.seed(1000)

cv_ctrl <- trainControl(
  method = "cv",
  number = 5,
  classProbs = TRUE,
  savePredictions = "final"
)

rf_final <- train(
  Diet_type ~ .,
  data = rf_data_sub,
  method = "rf",
  trControl = cv_ctrl,
  ntree = 500,
  importance = TRUE,
  metric = "Accuracy"
)

print(rf_final)

