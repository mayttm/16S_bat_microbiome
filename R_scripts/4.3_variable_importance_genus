library(randomForest)
library(dplyr)
library(tidyr)
library(ggplot2)
library(cowplot)
library(patchwork)

print(rf_final)

# --- 2. Variable Importance (one-vs-rest) ---
# We need to access the data used to train the model: rf_data_sub
diet_classes <- levels(rf_data_sub$Diet_type)
importance_list <- list()

for (diet in diet_classes) {
  # Create binary version of the data
  rf_data_binary <- rf_data_sub
  rf_data_binary$Diet_binary <- ifelse(rf_data_binary$Diet_type == diet, diet, paste0("Not_", diet))
  rf_data_binary$Diet_binary <- factor(rf_data_binary$Diet_binary)
  
  # Define X and Y
  # Note: -1 excludes the first column (Diet_type), and we also remove the new Diet_binary
  x <- rf_data_binary %>% select(-Diet_type, -Diet_binary)
  y <- rf_data_binary$Diet_binary
  
  # Train a temporary binary RF to get importance for this specific diet
  rf_bin <- randomForest(x = x, y = y, ntree = 500, importance = TRUE)
  
  # Extract importance
  imp <- importance(rf_bin, type = 1, scale = TRUE)
  imp_df <- data.frame(
    Taxa = rownames(imp),
    Importance = imp[, 1],
    Diet = diet
  )
  importance_list[[diet]] <- imp_df
}

importance_long <- bind_rows(importance_list)

# --- 3. Identify Diet with Highest CLR Abundance per genus ---
# We use rf_data_sub because it already contains the CLR transformed data
# (columns 2 onwards are the CLR values)
clr_df <- rf_data_sub %>% select(-Diet_type)
clr_df$Diet_type <- rf_data_sub$Diet_type

clr_long <- clr_df %>%
  pivot_longer(cols = -Diet_type, names_to = "Taxa", values_to = "CLR")

mean_abund <- clr_long %>%
  group_by(Taxa, Diet_type) %>%
  summarise(MeanCLR = mean(CLR), .groups = "drop")

winner_diet <- mean_abund %>%
  group_by(Taxa) %>%
  slice_max(order_by = MeanCLR, n = 1) %>%
  select(Taxa, Winner = Diet_type)

# --- 4. Merge Importance with Winner Data ---
importance_long <- importance_long %>%
  left_join(winner_diet, by = "Taxa") %>%
  mutate(
    Diet = case_when(
      Diet == "Fishes" ~ "Fish",
      Diet == "Fruits" ~ "Fruit",
      Diet == "Insects" ~ "Insect",
      Diet == "Blood" ~ "Blood",
      TRUE ~ Diet
    ),
    Winner = case_when(
      Winner == "Fishes" ~ "Fish",
      Winner == "Fruits" ~ "Fruit",
      Winner == "Insects" ~ "Insect",
      Winner == "Blood" ~ "Blood",
      TRUE ~ Winner
    )
  )

# --- 5. Get Top 20 Genera and Set Order by IMPORTANCE ---
# 1. Identify Top 20 based on Max Importance
top_taxa_names <- importance_long %>%
  group_by(Taxa) %>%
  summarise(MaxImportance = max(Importance), .groups = "drop") %>%
  slice_max(order_by = MaxImportance, n = 20, with_ties = FALSE) %>%
  pull(Taxa)

# 2. Define the Order (Descending Importance)
taxa_order <- importance_long %>%
  filter(Taxa %in% top_taxa_names) %>%
  group_by(Taxa) %>%
  summarise(MaxImportance = max(Importance), .groups = "drop") %>%
  arrange(desc(MaxImportance)) %>% # Highest importance at the top
  pull(Taxa)

# 3. Apply Factor to Importance Data
importance_long_top <- importance_long %>%
  filter(Taxa %in% top_taxa_names) %>%
  mutate(Taxa = factor(Taxa, levels = taxa_order))

# --- 6. Prepare Data for Plotting ---

# 1. Filter and Clean CLR Data
clr_long_top <- clr_long %>%
  filter(Taxa %in% top_taxa_names) %>%
  mutate(
    Taxa = factor(Taxa, levels = taxa_order), # ENFORCE IMPORTANCE ORDER HERE
    Diet_type = case_when(
      Diet_type == "Fishes" ~ "Fish",
      Diet_type == "Fruits" ~ "Fruit",
      Diet_type == "Insects" ~ "Insect",
      Diet_type == "Blood" ~ "Blood",
      TRUE ~ Diet_type
    ),
    CLR = as.numeric(CLR)
  )

# 2. Create Background Stripes Data
# We create this directly from taxa_order to ensure alignment
bg_stripes <- data.frame(Taxa = factor(taxa_order, levels = taxa_order)) %>%
  mutate(
    # Convert factor to numeric to determine odd/even rows
    as_numeric = as.numeric(Taxa),
    stripe = (as_numeric %% 2 == 1)
  )

print("Taxa Order (Importance):")
print(levels(clr_long_top$Taxa))

