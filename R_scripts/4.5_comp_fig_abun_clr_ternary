# ------------------------ FIGURE 3 PANEL ARRANGEMENT ------------------------ #

library(ggpubr)

abun_clr_ternary_panel <- ggarrange(
  abundance_genus_avg,  
  CLR_combined_genus,
  ternary_fish,
  labels = c("A", "B", "C"),
  ncol = 1,
  nrow = 3,
  heights = c(1.2, 1.2, 0.9) 
)

print(abun_clr_ternary_panel)

out_dir = "output_bioproj_prim/_FIGURES"
dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)

for (ext in c("jpg", "pdf", "tiff")) {
  ggsave(
    filename = file.path(out_dir, paste0("fig3_abun_clr_ternary_genus_ver2.", ext)),
    plot = abun_clr_ternary_panel,
    width = 14,
    height = 18,
    units = "in",
    dpi = 300
  )
}
