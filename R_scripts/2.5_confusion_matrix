## ------------ 1.4) identifying misclassified samples

library(tidyverse)
library(randomForest)

export_misclassified_diet1_caret <- function(model, 
                                             original_data, 
                                             out_dir = "output_bioproj_prim", 
                                             filename = "misclassified_samples_diet1.csv") {
  
  # --- 1. SETUP OUTPUT DIRECTORY ---
  if (!dir.exists(out_dir)) {
    dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
  }
  
  # --- 2. EXTRACT PREDICTIONS FROM CARET OBJECT ---
  # Check if predictions exist
  if (is.null(model$pred)) {
    stop("No predictions found in model object. Ensure 'savePredictions' was set to 'final' or TRUE in trainControl.")
  }
  
  # Extract the predictions dataframe
  # This contains columns: pred, obs, rowIndex, etc.
  pred_results <- model$pred
  
  # Filter to only the best tuning parameter (if multiple were tried)
  # Caret keeps predictions for all tuning parameters in model$pred
  # We only want the ones corresponding to the final model
  if ("mtry" %in% colnames(pred_results)) {
    pred_results <- pred_results[pred_results$mtry == model$bestTune$mtry, ]
  }
  
  # --- 3. IDENTIFY MISCLASSIFIED SAMPLES ---
  # Filter rows where Prediction does not match Observation
  misclassified_rows <- pred_results[pred_results$pred != pred_results$obs, ]
  
  if (nrow(misclassified_rows) == 0) {
    message("Great news! The model achieved 100% accuracy. No misclassified samples to export.")
    return(NULL)
  }
  
  # --- 4. MATCH BACK TO ORIGINAL METADATA ---
  # Caret preserves the original row index in the 'rowIndex' column
  # We use this to pull the correct metadata from 'original_data'
  
  # Get the indices of the misclassified samples
  original_indices <- misclassified_rows$rowIndex
  
  # Extract the corresponding rows from the original dataframe
  original_subset <- original_data[original_indices, ]
  
  # Construct the final dataframe
  final_output <- data.frame(
    SampleID       = rownames(original_subset), # Assuming rownames are SampleIDs
    Observed_Diet  = misclassified_rows$obs,
    Predicted_Diet = misclassified_rows$pred,
    Bioproject     = original_subset$bioproject,
    cw_diet1       = original_subset$cw_diet1,      # Adjust if column name differs
    Sample_Type    = original_subset$sample_type,   # Adjust if column name differs
    stringsAsFactors = FALSE
  )
  
  # --- 5. EXPORT ---
  full_path <- file.path(out_dir, filename)
  write.csv(final_output, full_path, row.names = FALSE)
  
  message(paste("Export complete. Found", nrow(final_output), "misclassified samples."))
  message(paste("Saved to:", full_path))
  
  return(final_output)
}

