## --------------- making confusion matrix plot ----------------------------- ##

make_confusion_plot_caret <- function(model, plot_title = "") {
  
  # 1. Check if predictions exist
  if (is.null(model$pred)) {
    stop("No predictions found. Ensure 'savePredictions' was set to 'final' or TRUE in trainControl.")
  }
  
  # 2. Extract Predictions and Observations
  results <- model$pred
  if ("mtry" %in% colnames(results)) {
    results <- results[results$mtry == model$bestTune$mtry, ]
  }
  
  predicted_classes <- results$pred
  observed_classes  <- results$obs
  
  # Ensure factors have the same levels
  all_levels <- levels(observed_classes)
  predicted_classes <- factor(predicted_classes, levels = all_levels)
  
  # 3. Create confusion matrix table
  cm_table <- table(Prediction = predicted_classes, Reference = observed_classes)
  cm_df <- as.data.frame(cm_table)
  
  # 4. Calculate Ratios
  cm_df <- cm_df %>%
    group_by(Reference) %>%
    mutate(
      Total = sum(Freq),
      Ratio = Freq / Total,
      Label = sprintf("%.2f", Ratio)
    ) %>%
    ungroup()
  
  # 5. Create plot
  ggplot(cm_df, aes(x = Reference, y = Prediction, fill = Ratio)) +
    geom_tile(color = "white", linewidth = 0.6) +
    geom_text(aes(label = Label),
              color = ifelse(cm_df$Ratio > 0.5, "black", "white"),
              size = 5, fontface = "bold") +
    scale_fill_viridis_c(name = "Ratio", labels = function(x) sprintf("%.2f", x)) +
    labs(x = "Expected Captivity Status and Diet", y = "Predicted Captivity Status and Diet", title = plot_title) +
    theme_minimal(base_size = 12) +
    theme(
      plot.margin = ggplot2::margin(t = 20, r = 10, b = 10, l = 10, unit = "pt"),
      panel.grid = element_blank(),
      axis.text.x = element_text(angle = 45, hjust = 1, face = "bold"),
      axis.text.y = element_text(face = "bold"),
      axis.title.x = element_text(size = 12, face = "bold"),
      axis.title.y = element_text(size = 12, face = "bold"),
      legend.title = element_text(face = "bold")
    )
}

